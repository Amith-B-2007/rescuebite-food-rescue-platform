<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.foodrescue</groupId>
    <artifactId>surplus-food-rescue-platform</artifactId>
    <version>1.0.0</version>
    <name>RescueBite - Surplus Food Rescue &amp; Redistribution Platform</name>
    <description>
        SDG 2 (Zero Hunger) &amp; SDG 12 (Responsible Consumption &amp; Production)
        Java Platform using java.util.PriorityQueue for Expiry Ranking &amp; Haversine Geo-Distance Calculation.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>com.foodrescue.FoodRescueServer</exec.mainClass>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.foodrescue.FoodRescueServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
